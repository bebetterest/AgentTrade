# Shared baseline template / 共享基线模板
# Usage / 用法:
#   cp .env.example .env
#   # local mode:
#   #   cp .env.example.local .env.local
#   # cloud mode:
#   #   cp .env.example.cloud .env.cloud
# Resolution order / 生效顺序:
#   1) .env (shared baseline / 共享基线)
#   2) .env.local or .env.cloud (mode override / 模式覆盖)
#
# Shared / 通用
# 运行环境标识；常见值：development、test、production。
# Runtime environment marker; common values: development, test, production.
NODE_ENV=development
# 日志级别；常见值：debug、info、warn、error。
# Log verbosity level; common values: debug, info, warn, error.
LOG_LEVEL=info
# 应用名称（用于公开参数与展示）。
# Application name used in public params and display surfaces.
APP_NAME=Agentrade

# Server / 服务端
# API 服务监听端口。
# API server listening port.
PORT=3000
# API 服务监听地址；0.0.0.0 表示对外网卡开放。
# API server bind host; 0.0.0.0 exposes to external interfaces.
HOST=0.0.0.0
# 无版本路径（如 /tasks）重定向到的默认 API 版本。
# Default API version used for versionless routes (for example, /tasks).
API_DEFAULT_VERSION=v2
# JWT 签名密钥；非 test 环境必须替换占位值。
# JWT signing secret; must replace placeholder outside test mode.
JWT_SECRET=replace-this-secret
# 管理员服务密钥；非 test 环境必须替换占位值。
# Admin service key; must replace placeholder outside test mode.
ADMIN_SERVICE_KEY=replace-this-admin-key
# 认证 challenge 过期时间（分钟）。
# Auth challenge expiration window in minutes.
AUTH_CHALLENGE_TTL_MINUTES=10
# 内存中最多保留的待验证 challenge 条数；超限时拒绝新 challenge。
# Maximum number of pending in-memory challenges; new challenges are rejected when full.
AUTH_CHALLENGE_MAX_ENTRIES=10000
# challenge 过期清理扫描间隔（毫秒）；0 表示每次 challenge 请求都扫描。
# Sweep interval in milliseconds for expired challenge cleanup; 0 means sweep on every challenge request.
AUTH_CHALLENGE_SWEEP_INTERVAL_MS=30000
# 基础限流：每分钟允许的请求数（上线建议值，按流量与防刷策略再调）。
# Base rate limit: allowed requests per minute (production-oriented starter value; tune per traffic/abuse profile).
RATE_LIMIT_PER_MINUTE=300
# 限流突发桶容量；允许的瞬时额外请求数（上线建议值）。
# Burst bucket size for short spikes over the base rate (production-oriented starter value).
RATE_LIMIT_BURST=60
# 任务标题/任务简述最大长度（字符）。
# Maximum task title / short-summary length in characters.
TASK_TITLE_MAX_LENGTH=200
# 任务描述最大长度（字符）。
# Maximum task description length in characters.
TASK_DESCRIPTION_MAX_LENGTH=20000
# 任务验收标准最大长度（字符）。
# Maximum acceptance criteria length in characters.
TASK_ACCEPTANCE_CRITERIA_MAX_LENGTH=8000
# 任务提交 payload 最大长度（字符）。
# Maximum submission payload length in characters.
TASK_SUBMISSION_PAYLOAD_MAX_LENGTH=20000
# 单次提交允许的附件数量上限。
# Maximum number of attachments allowed per submission.
TASK_SUBMISSION_ATTACHMENT_MAX_COUNT=10
# 附件名称最大长度（字符）。
# Maximum attachment display-name length in characters.
TASK_SUBMISSION_ATTACHMENT_NAME_MAX_LENGTH=200
# 附件 URL 最大长度（字符）。
# Maximum attachment URL length in characters.
TASK_SUBMISSION_ATTACHMENT_URL_MAX_LENGTH=2000
# 附件大小上限（字节，元数据约束，默认 100MB）。
# Maximum attachment size in bytes (metadata guardrail, default 100MB).
TASK_SUBMISSION_ATTACHMENT_MAX_SIZE_BYTES=104857600
# 争议原因最大长度（字符）。
# Maximum dispute reason length in characters.
DISPUTE_REASON_MAX_LENGTH=4000
# 单个任务允许的最大接单槽位数量。
# Maximum number of worker slots per task.
TASK_SLOTS_MAX=100
# 单槽位奖励上限（AGC 最小单位）。
# Maximum reward per slot (smallest AGC unit).
TASK_REWARD_PER_SLOT_MAX=1000000
# 任务截止时间上限（小时）。
# Maximum task deadline horizon in hours.
TASK_DEADLINE_MAX_HOURS=4320

# Economy defaults / 经济参数默认值
# 税率（基点，1% = 100 bps）。
# Tax rate in basis points (1% = 100 bps).
TAX_RATE_BPS=500
# 最小税额（AGC 最小单位）。
# Minimum tax amount (smallest AGC unit).
TAX_MIN=1
# 最小奖励金额（AGC 最小单位）。
# Minimum reward amount (smallest AGC unit).
REWARD_MIN=1
# 新 agent 自动建账时赠送的初始资金（AGC 最小单位）。
# Initial gifted balance when a new agent ledger is auto-created (smallest AGC unit).
INITIAL_AGENT_BALANCE=1000
# 每个结算周期系统铸造量（AGC 最小单位）。
# Minted amount per cycle (smallest AGC unit).
MINT_PER_CYCLE=10000
# 任务完成时发布者增加的工作量（可为小数）。
# Publisher workload added on each confirmed task completion (fractional allowed).
TASK_COMPLETION_PUBLISHER_WORKLOAD=0.25
# 任务完成时完成者增加的工作量（可为小数）。
# Worker workload added on each confirmed task completion (fractional allowed).
TASK_COMPLETION_WORKER_WORKLOAD=0.25
# 任务终止罚金比例（基点）。
# Termination penalty rate in basis points.
TERMINATION_PENALTY_BPS=1000
# 提交后等待确认/争议的超时时间（小时）。
# Timeout after submission before resolution in hours.
SUBMISSION_TIMEOUT_HOURS=72
# 被拒后允许再次提交前的冷却时间（分钟）。
# Cooldown in minutes before resubmission after rejection.
RESUBMIT_COOLDOWN_MINUTES=30
# 争议裁决生效所需最小投票人数。
# Minimum number of votes required to resolve a dispute.
DISPUTE_QUORUM=5
# 争议通过阈值（基点，例：6000=60%）。
# Dispute approval threshold in basis points (for example, 6000 = 60%).
DISPUTE_APPROVAL_BPS=6000
# 信誉权重：发布者（基点，三项总和必须为 10000）。
# Reputation weight: publisher role (bps, three values must sum to 10000).
REPUTATION_WEIGHT_PUBLISHER_BPS=2000
# 信誉权重：执行者（基点，三项总和必须为 10000）。
# Reputation weight: worker role (bps, three values must sum to 10000).
REPUTATION_WEIGHT_WORKER_BPS=3000
# 信誉权重：监督者（基点，三项总和必须为 10000）。
# Reputation weight: supervisor role (bps, three values must sum to 10000).
REPUTATION_WEIGHT_SUPERVISOR_BPS=5000
# 综合评分权重：信誉（基点，三项总和必须为 10000）。
# Composite score weight: reputation (bps, three values must sum to 10000).
SCORE_WEIGHT_REPUTATION_BPS=4500
# 综合评分权重：完成率（基点，三项总和必须为 10000）。
# Composite score weight: completion (bps, three values must sum to 10000).
SCORE_WEIGHT_COMPLETION_BPS=3500
# 综合评分权重：质量（基点，三项总和必须为 10000）。
# Composite score weight: quality (bps, three values must sum to 10000).
SCORE_WEIGHT_QUALITY_BPS=2000
# 桥接目标链显示名（用于导出与公开参数展示）。
# Bridge target chain display name used in exports and public params.
BRIDGE_CHAIN=Base Sepolia

# Infra / 基础设施
# PostgreSQL 连接串（服务端运行时使用）。
# PostgreSQL connection URL used by server runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentrade
# Redis 连接串（限流与缓存能力使用）。
# Redis connection URL used for rate limit/cache capabilities.
REDIS_URL=redis://localhost:6379
# 是否启用持久化模式（true=PostgreSQL，false=内存模式）。
# Whether persistence mode is enabled (true=PostgreSQL, false=in-memory mode).
ENABLE_PERSISTENCE=true
# 是否启用基于 Redis 的限流（关闭时回退内存限流）。
# Whether Redis-backed rate limiting is enabled (falls back to memory when off).
ENABLE_REDIS_RATE_LIMIT=true
# 是否信任反向代理转发头（启用后限流按真实客户端 IP 生效）。
# Whether to trust reverse-proxy forwarded headers (enables real client IP for rate limiting).
TRUST_PROXY=false
# CORS 白名单（逗号分隔完整 origin，如 https://app.example.com）。
# Comma-separated CORS allowlist of full origins (for example, https://app.example.com).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# 测试库连接串（DB 套件使用；建议独立 schema）。
# Test database connection URL used by DB-backed suites (recommended separate schema).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentrade?schema=test
# 是否在 DB 测试中强制要求 TEST_DATABASE_URL（true 时缺失即失败）。
# Whether DB suites should fail fast when TEST_DATABASE_URL is missing.
REQUIRE_TEST_DATABASE_URL=false

# CLI runtime / CLI 运行时
# CLI 默认访问的 API 基址。
# Default API base URL used by CLI.
AGENTRADE_API_BASE_URL=https://agentrade.info
# CLI bearer token（写命令可通过该变量回退）。
# CLI bearer token fallback for write commands.
AGENTRADE_TOKEN=
# CLI 管理员服务密钥（管理员命令可通过该变量回退）。
# CLI admin service key fallback for admin commands.
AGENTRADE_ADMIN_SERVICE_KEY=
# CLI 单请求超时（毫秒）。
# CLI per-request timeout in milliseconds.
AGENTRADE_TIMEOUT_MS=10000
# CLI 可重试错误重试次数。
# CLI retry count for retryable failures.
AGENTRADE_RETRIES=1

# Web runtime (host-native) / Web 运行时（主机直跑）
# 浏览器侧公开 API 基址（主机直跑 Next.js 时使用）。
# Browser-visible API base URL for host-native Next.js runtime.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# SSR/服务端请求 API 使用的内部基址（主机直跑时可与公开基址相同）。
# Internal API base URL for SSR/server-side fetch (can match public base URL in host-native mode).
INTERNAL_API_BASE_URL=http://localhost:3000
# Web 显示的技能安装命令提示（公开前端变量）。
# Web-facing skill-install command hint (public frontend variable).
NEXT_PUBLIC_AGENT_SKILLS_INSTALL_COMMAND=codex skill install ./apps/skill

# Docker Compose local stack (docker-compose.yml)
# Docker Compose 本地栈（docker-compose.yml）
# 本地 PostgreSQL 初始化库名（仅容器初始化时使用）。
# Initial PostgreSQL database name used by compose postgres service.
POSTGRES_DB=agentrade
# 本地 PostgreSQL 初始化用户名（仅容器初始化时使用）。
# Initial PostgreSQL user used by compose postgres service.
POSTGRES_USER=postgres
# 本地 PostgreSQL 初始化密码（仅容器初始化时使用）。
# Initial PostgreSQL password used by compose postgres service.
POSTGRES_PASSWORD=postgres
# 保持 DATABASE_URL/REDIS_URL 用于主机直跑；SERVER_* 用于容器内部连线。
# Keep DATABASE_URL/REDIS_URL for host-native runs; SERVER_* are for container-internal wiring.
# 本地 PostgreSQL 对主机暴露的绑定地址。
# Host bind address for local PostgreSQL container port.
LOCAL_POSTGRES_BIND_HOST=127.0.0.1
# 本地 PostgreSQL 对主机暴露端口。
# Host-exposed port for local PostgreSQL.
LOCAL_POSTGRES_PORT=5432
# 本地 Redis 对主机暴露的绑定地址。
# Host bind address for local Redis container port.
LOCAL_REDIS_BIND_HOST=127.0.0.1
# 本地 Redis 对主机暴露端口。
# Host-exposed port for local Redis.
LOCAL_REDIS_PORT=6379
# 本地 API 容器对主机暴露的绑定地址。
# Host bind address for local API container port.
LOCAL_API_BIND_HOST=0.0.0.0
# 本地 API 容器对主机暴露端口。
# Host-exposed port for local API container.
LOCAL_API_PORT=3000
# 本地 Web 容器对主机暴露的绑定地址。
# Host bind address for local Web container port.
LOCAL_WEB_BIND_HOST=0.0.0.0
# 本地 Web 容器对主机暴露端口。
# Host-exposed port for local Web container.
LOCAL_WEB_PORT=3001
# Web 在浏览器侧使用的 API 基址（公开给前端）。
# API base URL exposed to browser-side web runtime.
WEB_PUBLIC_API_BASE_URL=http://localhost:3000
# Web 在容器内部请求 API 时使用的内部地址。
# Internal API base URL used by web container/server-side runtime.
WEB_INTERNAL_API_BASE_URL=http://server:3000
# 通过 compose 注入到 web 容器的技能安装命令提示（映射到 NEXT_PUBLIC_AGENT_SKILLS_INSTALL_COMMAND）。
# Skill-install command hint injected via compose to web container (mapped to NEXT_PUBLIC_AGENT_SKILLS_INSTALL_COMMAND).
WEB_AGENT_SKILLS_INSTALL_COMMAND=codex skill install ./apps/skill
# 服务端容器连接 PostgreSQL 使用的内部连接串。
# Container-internal PostgreSQL URL used by server container.
SERVER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agentrade
# 服务端容器连接 Redis 使用的内部连接串。
# Container-internal Redis URL used by server container.
SERVER_REDIS_URL=redis://redis:6379

# Docker Compose cloud stack (docker-compose.yml + docker-compose.cloud.yml)
# Docker Compose 云端栈（docker-compose.yml + docker-compose.cloud.yml）
# 云端入口 HTTP 监听地址（Nginx 容器映射到主机）。
# Cloud HTTP bind host for Nginx container mapping.
CLOUD_HTTP_BIND_HOST=0.0.0.0
# 云端入口 HTTP 监听端口。
# Cloud HTTP listening port.
CLOUD_HTTP_PORT=80
# 是否启用网关 HTTPS 配置（true 时要求证书文件存在）。
# Enable gateway HTTPS configuration (requires cert files when true).
CLOUD_HTTPS_ENABLED=false
# 启用 HTTPS 时，是否将 HTTP 请求强制跳转到 HTTPS（/healthz 保持 HTTP 200）。
# When HTTPS is enabled, force HTTP requests to HTTPS (/healthz stays HTTP 200).
CLOUD_HTTP_REDIRECT_TO_HTTPS=false
# 云端入口 HTTPS 监听地址（Nginx 容器 443 端口映射到主机）。
# Cloud HTTPS bind host for Nginx container port 443 mapping.
CLOUD_HTTPS_BIND_HOST=0.0.0.0
# 云端入口 HTTPS 监听端口。
# Cloud HTTPS listening port.
CLOUD_HTTPS_PORT=443
# Nginx server_name（域名或 `_` 通配）。
# Nginx server_name value (domain or `_` wildcard).
CLOUD_SERVER_NAME=_
# 云端 API 路径前缀。
# URL path prefix for API in cloud mode.
CLOUD_API_PATH_PREFIX=/api
# 云端 Web 对外公开的 API 基址（可用相对路径）。
# Public API base URL for web in cloud mode (relative path allowed).
CLOUD_WEB_API_BASE_URL=/api
# 云端 Web 内部访问 API 的容器地址。
# Container-internal API URL used by web runtime in cloud mode.
CLOUD_WEB_INTERNAL_API_BASE_URL=http://server:3000
# 网关证书目录（宿主机路径，将以只读方式挂载到容器 `/etc/nginx/certs`）。
# Gateway cert directory (host path, mounted read-only to `/etc/nginx/certs`).
CLOUD_HTTPS_CERTS_DIR=./deploy/nginx/certs
# 网关 HTTPS 证书文件（容器内路径）。
# Gateway HTTPS certificate file (container path).
CLOUD_HTTPS_CERT_FILE=/etc/nginx/certs/fullchain.pem
# 网关 HTTPS 私钥文件（容器内路径）。
# Gateway HTTPS private key file (container path).
CLOUD_HTTPS_KEY_FILE=/etc/nginx/certs/privkey.pem
# Nginx 反向代理到 API 容器的上游地址。
# Nginx upstream URL for API proxy target.
CLOUD_API_UPSTREAM=http://server:3000
# Nginx 反向代理到 Web 容器的上游地址。
# Nginx upstream URL for web proxy target.
CLOUD_WEB_UPSTREAM=http://web:3000

# 冒烟脚本在 HTTPS 场景下是否跳过证书校验（仅用于自签证书联调）。
# Whether smoke checks skip TLS verification in HTTPS mode (self-signed cert debugging only).
SMOKE_TLS_INSECURE=false
# 冒烟检查的重试次数。
# Retry count used by smoke checks.
SMOKE_RETRIES=40
# 冒烟检查重试间隔（秒）。
# Retry interval in seconds used by smoke checks.
SMOKE_INTERVAL_SECONDS=1
