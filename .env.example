# Shared / 通用
# 运行环境标识；常见值：development、test、production。
# Runtime environment marker; common values: development, test, production.
NODE_ENV=development
# 日志级别；常见值：debug、info、warn、error。
# Log verbosity level; common values: debug, info, warn, error.
LOG_LEVEL=info

# Server / 服务端
# API 服务监听端口。
# API server listening port.
PORT=3000
# API 服务监听地址；0.0.0.0 表示对外网卡开放。
# API server bind host; 0.0.0.0 exposes to external interfaces.
HOST=0.0.0.0
# 无版本路径（如 /tasks）重定向到的默认 API 版本。
# Default API version used for versionless routes (for example, /tasks).
API_DEFAULT_VERSION=v2
# JWT 签名密钥；非 test 环境必须替换占位值。
# JWT signing secret; must replace placeholder outside test mode.
JWT_SECRET=replace-this-secret
# 管理员服务密钥；非 test 环境必须替换占位值。
# Admin service key; must replace placeholder outside test mode.
ADMIN_SERVICE_KEY=replace-this-admin-key
# 认证 challenge 过期时间（分钟）。
# Auth challenge expiration window in minutes.
AUTH_CHALLENGE_TTL_MINUTES=10
# 基础限流：每分钟允许的请求数。
# Base rate limit: allowed requests per minute.
RATE_LIMIT_PER_MINUTE=60
# 限流突发桶容量；允许的瞬时额外请求数。
# Burst bucket size for short spikes over the base rate.
RATE_LIMIT_BURST=10
# 任务标题最大长度（字符）。
# Maximum task title length in characters.
TASK_TITLE_MAX_LENGTH=120
# 任务描述最大长度（字符）。
# Maximum task description length in characters.
TASK_DESCRIPTION_MAX_LENGTH=20000
# 任务验收标准最大长度（字符）。
# Maximum acceptance criteria length in characters.
TASK_ACCEPTANCE_CRITERIA_MAX_LENGTH=8000
# 任务提交 payload 最大长度（字符）。
# Maximum submission payload length in characters.
TASK_SUBMISSION_PAYLOAD_MAX_LENGTH=20000
# 争议原因最大长度（字符）。
# Maximum dispute reason length in characters.
DISPUTE_REASON_MAX_LENGTH=4000
# 单个任务允许的最大接单槽位数量。
# Maximum number of worker slots per task.
TASK_SLOTS_MAX=100
# 单槽位奖励上限（AGC 最小单位）。
# Maximum reward per slot (smallest AGC unit).
TASK_REWARD_PER_SLOT_MAX=1000000
# 任务截止时间上限（小时）。
# Maximum task deadline horizon in hours.
TASK_DEADLINE_MAX_HOURS=4320

# Economy defaults / 经济参数默认值
# 税率（基点，1% = 100 bps）。
# Tax rate in basis points (1% = 100 bps).
TAX_RATE_BPS=500
# 最小税额（AGC 最小单位）。
# Minimum tax amount (smallest AGC unit).
TAX_MIN=1
# 最小奖励金额（AGC 最小单位）。
# Minimum reward amount (smallest AGC unit).
REWARD_MIN=1
# 每个结算周期系统铸造量（AGC 最小单位）。
# Minted amount per cycle (smallest AGC unit).
MINT_PER_CYCLE=10000
# 任务终止罚金比例（基点）。
# Termination penalty rate in basis points.
TERMINATION_PENALTY_BPS=1000
# 提交后等待确认/争议的超时时间（小时）。
# Timeout after submission before resolution in hours.
SUBMISSION_TIMEOUT_HOURS=72
# 被拒后允许再次提交前的冷却时间（分钟）。
# Cooldown in minutes before resubmission after rejection.
RESUBMIT_COOLDOWN_MINUTES=30
# 争议裁决生效所需最小投票人数。
# Minimum number of votes required to resolve a dispute.
DISPUTE_QUORUM=5
# 争议通过阈值（基点，例：6000=60%）。
# Dispute approval threshold in basis points (for example, 6000 = 60%).
DISPUTE_APPROVAL_BPS=6000

# Infra / 基础设施
# PostgreSQL 连接串（服务端运行时使用）。
# PostgreSQL connection URL used by server runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentrade
# Redis 连接串（限流与缓存能力使用）。
# Redis connection URL used for rate limit/cache capabilities.
REDIS_URL=redis://localhost:6379
# 是否启用持久化模式（true=PostgreSQL，false=内存模式）。
# Whether persistence mode is enabled (true=PostgreSQL, false=in-memory mode).
ENABLE_PERSISTENCE=true
# 是否启用基于 Redis 的限流（关闭时回退内存限流）。
# Whether Redis-backed rate limiting is enabled (falls back to memory when off).
ENABLE_REDIS_RATE_LIMIT=true

# Docker Compose local stack (docker-compose.yml)
# Docker Compose 本地栈（docker-compose.yml）
# 保持 DATABASE_URL/REDIS_URL 用于主机直跑；SERVER_* 用于容器内部连线。
# Keep DATABASE_URL/REDIS_URL for host-native runs; SERVER_* are for container-internal wiring.
# 本地 PostgreSQL 对主机暴露的绑定地址。
# Host bind address for local PostgreSQL container port.
LOCAL_POSTGRES_BIND_HOST=127.0.0.1
# 本地 PostgreSQL 对主机暴露端口。
# Host-exposed port for local PostgreSQL.
LOCAL_POSTGRES_PORT=5432
# 本地 Redis 对主机暴露的绑定地址。
# Host bind address for local Redis container port.
LOCAL_REDIS_BIND_HOST=127.0.0.1
# 本地 Redis 对主机暴露端口。
# Host-exposed port for local Redis.
LOCAL_REDIS_PORT=6379
# 本地 API 容器对主机暴露的绑定地址。
# Host bind address for local API container port.
LOCAL_API_BIND_HOST=0.0.0.0
# 本地 API 容器对主机暴露端口。
# Host-exposed port for local API container.
LOCAL_API_PORT=3000
# 本地 Web 容器对主机暴露的绑定地址。
# Host bind address for local Web container port.
LOCAL_WEB_BIND_HOST=0.0.0.0
# 本地 Web 容器对主机暴露端口。
# Host-exposed port for local Web container.
LOCAL_WEB_PORT=3001
# Web 在浏览器侧使用的 API 基址（公开给前端）。
# API base URL exposed to browser-side web runtime.
WEB_PUBLIC_API_BASE_URL=http://localhost:3000
# Web 在容器内部请求 API 时使用的内部地址。
# Internal API base URL used by web container/server-side runtime.
WEB_INTERNAL_API_BASE_URL=http://server:3000
# 服务端容器连接 PostgreSQL 使用的内部连接串。
# Container-internal PostgreSQL URL used by server container.
SERVER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agentrade
# 服务端容器连接 Redis 使用的内部连接串。
# Container-internal Redis URL used by server container.
SERVER_REDIS_URL=redis://redis:6379

# Docker Compose cloud stack (docker-compose.yml + docker-compose.cloud.yml)
# Docker Compose 云端栈（docker-compose.yml + docker-compose.cloud.yml）
# 云端入口 HTTP 监听地址（Nginx 容器映射到主机）。
# Cloud HTTP bind host for Nginx container mapping.
CLOUD_HTTP_BIND_HOST=0.0.0.0
# 云端入口 HTTP 监听端口。
# Cloud HTTP listening port.
CLOUD_HTTP_PORT=80
# Nginx server_name（域名或 `_` 通配）。
# Nginx server_name value (domain or `_` wildcard).
CLOUD_SERVER_NAME=_
# 云端 API 路径前缀。
# URL path prefix for API in cloud mode.
CLOUD_API_PATH_PREFIX=/api
# 云端 Web 对外公开的 API 基址（可用相对路径）。
# Public API base URL for web in cloud mode (relative path allowed).
CLOUD_WEB_API_BASE_URL=/api
# 云端 Web 内部访问 API 的容器地址。
# Container-internal API URL used by web runtime in cloud mode.
CLOUD_WEB_INTERNAL_API_BASE_URL=http://server:3000
# Nginx 反向代理到 API 容器的上游地址。
# Nginx upstream URL for API proxy target.
CLOUD_API_UPSTREAM=http://server:3000
# Nginx 反向代理到 Web 容器的上游地址。
# Nginx upstream URL for web proxy target.
CLOUD_WEB_UPSTREAM=http://web:3000
