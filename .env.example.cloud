# Cloud domain deployment template / 云端域名部署模板
# Usage / 用法:
#   cp .env.example.cloud .env
#   pnpm docker:stack:cloud:up

# Shared / 通用
NODE_ENV=production
LOG_LEVEL=info
APP_NAME=Agentrade

# Security / 安全
# Replace both values before non-test startup.
# 非 test 环境启动前必须替换以下占位值。
JWT_SECRET=replace-this-secret
ADMIN_SERVICE_KEY=replace-this-admin-key

# Server runtime / 服务端运行时
HOST=0.0.0.0
PORT=3000
API_DEFAULT_VERSION=v2
ENABLE_PERSISTENCE=true
ENABLE_REDIS_RATE_LIMIT=true
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
# Initial gifted balance for newly created agent ledgers (smallest AGC unit).
# 新创建 agent 账本的初始赠送资金（AGC 最小单位）。
INITIAL_AGENT_BALANCE=1000

# Database & Redis (host-native fallback) / 主机直跑回退连接
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentrade
REDIS_URL=redis://localhost:6379

# Compose PostgreSQL bootstrap / Compose 初始化参数
POSTGRES_DB=agentrade
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Compose service wiring / Compose 容器内服务连线
SERVER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agentrade
SERVER_REDIS_URL=redis://redis:6379

# Cloud gateway routing / 云端网关路由
CLOUD_HTTP_BIND_HOST=0.0.0.0
CLOUD_HTTP_PORT=80
CLOUD_SERVER_NAME=example.com
CLOUD_API_PATH_PREFIX=/api
CLOUD_WEB_API_BASE_URL=/api
CLOUD_WEB_INTERNAL_API_BASE_URL=http://server:3000
CLOUD_API_UPSTREAM=http://server:3000
CLOUD_WEB_UPSTREAM=http://web:3000

# HTTPS / TLS / HTTPS 配置
CLOUD_HTTPS_ENABLED=true
CLOUD_HTTP_REDIRECT_TO_HTTPS=true
CLOUD_HTTPS_BIND_HOST=0.0.0.0
CLOUD_HTTPS_PORT=443
CLOUD_HTTPS_CERTS_DIR=./deploy/nginx/certs
CLOUD_HTTPS_CERT_FILE=/etc/nginx/certs/fullchain.pem
CLOUD_HTTPS_KEY_FILE=/etc/nginx/certs/privkey.pem

# Web container runtime / Web 容器运行时
WEB_AGENT_SKILLS_INSTALL_COMMAND=codex skill install ./apps/skill

# Optional smoke tuning / 可选冒烟参数
SMOKE_TLS_INSECURE=false
SMOKE_RETRIES=40
SMOKE_INTERVAL_SECONDS=1
