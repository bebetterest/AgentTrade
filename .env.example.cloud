# Cloud mode override template / 云端模式覆盖模板
# Usage / 用法:
#   cp .env.example .env
#   cp .env.example.cloud .env.cloud
#   pnpm docker:release:cloud -- --web-url https://<your-domain>
#   # brand-new platform (destructive: wipe persisted data):
#   # 全新平台重建（破坏性：会清空持久化数据）：
#   #   pnpm docker:release:cloud -- --web-url https://<your-domain> --fresh-platform
# Runtime note / 运行时说明:
#   Scripts require a real `.env.cloud`; this template is not consumed directly at runtime.
#   脚本要求真实存在 `.env.cloud`；本模板不会在运行时被直接读取。
#
# Resolution order / 生效顺序:
#   1) .env (shared baseline / 共享基线)
#   2) .env.cloud (this file / 本文件覆盖)

# Required edits before cloud deployment / 云端部署前必须修改
# 云端前端 origin 白名单；至少包含你的正式 HTTPS 域名。
# Cloud frontend origin allowlist; include your production HTTPS domain(s).
CORS_ALLOWED_ORIGINS=https://agentrade.info,https://www.agentrade.info
# Nginx server_name；填写你的正式域名。
# Nginx server_name; set your public domain.
CLOUD_SERVER_NAME=agentrade.info
# API 对外路径前缀；通常与 NEXT_PUBLIC_API_BASE_URL 保持一致。
# External API path prefix; usually keep aligned with NEXT_PUBLIC_API_BASE_URL.
CLOUD_API_PATH_PREFIX=/api
# 浏览器侧 API 基址；同域部署建议使用相对路径并与 CLOUD_API_PATH_PREFIX 对齐。
# Browser API base URL; for same-domain deploys use a relative path aligned with CLOUD_API_PATH_PREFIX.
NEXT_PUBLIC_API_BASE_URL=/api
# 宿主机证书目录；会只读挂载到容器 /etc/nginx/certs。
# Host cert directory mounted read-only to /etc/nginx/certs in container.
CLOUD_HTTPS_CERTS_DIR=./cloud_https_certs
# 容器内证书文件路径（需与挂载目录中的文件名一致）。
# In-container cert file path (must match mounted filename).
CLOUD_HTTPS_CERT_FILE=/etc/nginx/certs/agentrade.info_bundle.pem
# 容器内私钥文件路径（需与挂载目录中的文件名一致）。
# In-container key file path (must match mounted filename).
CLOUD_HTTPS_KEY_FILE=/etc/nginx/certs/agentrade.info.key

# Runtime profile / 运行环境画像
# 云端建议 production。
# Cloud deployments should use production.
NODE_ENV=production
# 日志级别；线上建议 info，排障时短时调 debug。
# Log level; info for normal operation, debug for short diagnostics.
LOG_LEVEL=info

# Proxy and CORS / 代理与跨域
# 网关/Nginx 前置部署必须为 true。
# Must be true when running behind gateway/Nginx.
TRUST_PROXY=true

# Gateway routing / 网关路由
# HTTP 监听地址（宿主机绑定）。
# HTTP bind host on the machine.
CLOUD_HTTP_BIND_HOST=0.0.0.0
# HTTP 监听端口；通常 80。
# HTTP listen port; usually 80.
CLOUD_HTTP_PORT=80
# Web SSR 容器内访问 API 的地址。
# Internal API URL for web SSR in container network.
INTERNAL_API_BASE_URL=http://server:3000
# 网关反代 API 上游地址。
# Gateway upstream URL for API.
CLOUD_API_UPSTREAM=http://server:3000
# 网关反代 Web 上游地址。
# Gateway upstream URL for web.
CLOUD_WEB_UPSTREAM=http://web:3000

# HTTPS / TLS
# 是否启用 HTTPS；true 时证书和私钥必须存在且可读。
# Enable HTTPS; cert and key must exist/readable when true.
CLOUD_HTTPS_ENABLED=true
# 是否将 HTTP 跳转到 HTTPS（/healthz 不跳转）。
# Redirect HTTP to HTTPS (/healthz stays non-redirected).
CLOUD_HTTP_REDIRECT_TO_HTTPS=true
# HTTPS 监听地址（宿主机绑定）。
# HTTPS bind host on the machine.
CLOUD_HTTPS_BIND_HOST=0.0.0.0
# HTTPS 监听端口；通常 443。
# HTTPS listen port; usually 443.
CLOUD_HTTPS_PORT=443

# Container internal wiring / 容器内连线
# server 容器连接 PostgreSQL 的内部连接串。
# Container-internal PostgreSQL URL used by server.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agentrade
# server 容器连接 Redis 的内部连接串。
# Container-internal Redis URL used by server.
REDIS_URL=redis://redis:6379
