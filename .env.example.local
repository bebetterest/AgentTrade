# Local mode override template / 本地模式覆盖模板
# Usage / 用法:
#   cp .env.example .env
#   cp .env.example.local .env.local
#   pnpm docker:stack:local:up
#
# Resolution order / 生效顺序:
#   1) .env (shared baseline / 共享基线)
#   2) .env.local (this file / 本文件覆盖)

# Runtime profile / 运行环境画像
# 本地 Docker 建议使用 production，行为更贴近线上。
# Local Docker usually uses production for production-like behavior.
NODE_ENV=production
# 日志级别；排障时可临时改为 debug。
# Log level; temporarily use debug during troubleshooting.
LOG_LEVEL=info

# Proxy and CORS / 代理与跨域
# 本地直连 API 通常保持 false。
# Keep false for direct local API access (no reverse proxy in front).
TRUST_PROXY=false
# 本地前端 origin 白名单；按你的实际访问地址填写。
# Local frontend origin allowlist; set to real local origins you use.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000

# Local published ports / 本地端口映射
# PostgreSQL 暴露地址；仅本机访问建议 127.0.0.1。
# PostgreSQL bind address; use 127.0.0.1 for host-local access only.
LOCAL_POSTGRES_BIND_HOST=127.0.0.1
# PostgreSQL 暴露端口；冲突时改为其他端口。
# PostgreSQL published port; change if 5432 is occupied.
LOCAL_POSTGRES_PORT=5432
# Redis 暴露地址；仅本机访问建议 127.0.0.1。
# Redis bind address; use 127.0.0.1 for host-local access only.
LOCAL_REDIS_BIND_HOST=127.0.0.1
# Redis 暴露端口；冲突时改为其他端口。
# Redis published port; change if 6379 is occupied.
LOCAL_REDIS_PORT=6379
# API 暴露地址；0.0.0.0 允许局域网访问。
# API bind address; 0.0.0.0 allows LAN access.
LOCAL_API_BIND_HOST=0.0.0.0
# API 暴露端口。
# API published port.
LOCAL_API_PORT=3000
# Web 暴露地址；0.0.0.0 允许局域网访问。
# Web bind address; 0.0.0.0 allows LAN access.
LOCAL_WEB_BIND_HOST=0.0.0.0
# Web 暴露端口。
# Web published port.
LOCAL_WEB_PORT=3001

# Local container routing / 本地容器路由
# 浏览器侧 API 基址；通常指向本机 API 暴露地址。
# Browser-visible API base URL; usually points to host-exposed API.
WEB_PUBLIC_API_BASE_URL=http://localhost:3000
# Web SSR 在容器内访问 API 的地址；通常保持 server:3000。
# Web SSR internal API URL in container network; usually server:3000.
WEB_INTERNAL_API_BASE_URL=http://server:3000
# server 容器连接 PostgreSQL 的内部连接串。
# Container-internal PostgreSQL URL used by server.
SERVER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agentrade
# server 容器连接 Redis 的内部连接串。
# Container-internal Redis URL used by server.
SERVER_REDIS_URL=redis://redis:6379

# Optional smoke tuning / 可选冒烟参数
# 自签证书调试时才设为 true；本地 HTTP 一般保持 false。
# Set true only for self-signed TLS smoke debugging; keep false for normal local HTTP.
SMOKE_TLS_INSECURE=false
# 冒烟重试次数；启动慢时可调大。
# Smoke retry count; increase for slower startup.
SMOKE_RETRIES=40
# 冒烟重试间隔（秒）。
# Smoke retry interval in seconds.
SMOKE_INTERVAL_SECONDS=1
