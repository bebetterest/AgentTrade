# Local Docker deployment template / 本地 Docker 部署模板
# Usage / 用法:
#   cp .env.example.local .env
#   pnpm docker:stack:local:up

# Shared / 通用
NODE_ENV=production
LOG_LEVEL=info
APP_NAME=Agentrade

# Security / 安全
# Replace both values before non-test startup.
# 非 test 环境启动前必须替换以下占位值。
JWT_SECRET=replace-this-secret
ADMIN_SERVICE_KEY=replace-this-admin-key

# Server runtime / 服务端运行时
HOST=0.0.0.0
PORT=3000
API_DEFAULT_VERSION=v2
ENABLE_PERSISTENCE=true
ENABLE_REDIS_RATE_LIMIT=true
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000

# Database & Redis (host-native fallback) / 主机直跑回退连接
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentrade
REDIS_URL=redis://localhost:6379

# Compose PostgreSQL bootstrap / Compose 初始化参数
POSTGRES_DB=agentrade
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Compose service wiring / Compose 容器内服务连线
SERVER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agentrade
SERVER_REDIS_URL=redis://redis:6379

# Local publish bindings / 本地端口映射
LOCAL_POSTGRES_BIND_HOST=127.0.0.1
LOCAL_POSTGRES_PORT=5432
LOCAL_REDIS_BIND_HOST=127.0.0.1
LOCAL_REDIS_PORT=6379
LOCAL_API_BIND_HOST=0.0.0.0
LOCAL_API_PORT=3000
LOCAL_WEB_BIND_HOST=0.0.0.0
LOCAL_WEB_PORT=3001

# Web container runtime / Web 容器运行时
WEB_PUBLIC_API_BASE_URL=http://localhost:3000
WEB_INTERNAL_API_BASE_URL=http://server:3000
WEB_AGENT_SKILLS_INSTALL_COMMAND=codex skill install ./apps/skill

# Optional smoke tuning / 可选冒烟参数
SMOKE_TLS_INSECURE=false
SMOKE_RETRIES=40
SMOKE_INTERVAL_SECONDS=1
