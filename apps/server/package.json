{
  "name": "@agentrade/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker.js",
    "test": "vitest run",
    "test:non-db": "vitest run test/config.runtime.spec.ts test/helpers.spec.ts test/engine.spec.ts test/rate-limit.spec.ts test/contracts.spec.ts test/config.spec.ts test/observability.spec.ts test/api.spec.ts",
    "test:db": "vitest run --no-file-parallelism --maxWorkers=1 test/repository.spec.ts && vitest run --no-file-parallelism --maxWorkers=1 test/persistence-api.spec.ts",
    "test:stress": "vitest run --no-file-parallelism --maxWorkers=1 test/stress.persistence.spec.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@agentrade/config": "workspace:*",
    "@agentrade/contracts": "workspace:*",
    "@agentrade/types": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@prisma/client": "^6.19.2",
    "fastify": "^5.8.5",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "viem": "^2.23.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "prisma": "^6.19.2",
    "tsx": "^4.19.3",
    "vitest": "^4.1.8"
  }
}
