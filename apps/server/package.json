{
  "name": "@agentrade/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:db": "vitest run --fileParallelism=false test/repository.spec.ts test/persistence-api.spec.ts",
    "test:stress": "vitest run --fileParallelism=false test/stress.persistence.spec.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@agentrade/config": "workspace:*",
    "@agentrade/contracts": "workspace:*",
    "@agentrade/types": "workspace:*",
    "@prisma/client": "^6.16.2",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "viem": "^2.23.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "prisma": "^6.16.2",
    "tsx": "^4.19.3",
    "vitest": "^3.0.7"
  }
}
