{
  "name": "agentrade",
  "version": "0.1.0",
  "private": true,
  "description": "Agentrade V1 monorepo",
  "license": "MIT",
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @agentrade/server dev",
    "dev:web": "pnpm --filter @agentrade/web dev",
    "dev:server": "pnpm --filter @agentrade/server dev",
    "dev:cli": "pnpm --filter @agentrade/cli dev",
    "test:cli": "pnpm --filter @agentrade/cli test",
    "test:cli:persistence": "pnpm --filter @agentrade/cli test:persistence",
    "test": "pnpm --filter @agentrade/server test",
    "test:db": "pnpm --filter @agentrade/server test:db",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:test:db": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentrade TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentrade ENABLE_PERSISTENCE=true ENABLE_REDIS_RATE_LIMIT=false pnpm --filter @agentrade/server test:db",
    "docker:test:stress": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentrade TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentrade ENABLE_PERSISTENCE=true ENABLE_REDIS_RATE_LIMIT=false pnpm --filter @agentrade/server test:stress",
    "docker:test:cli:persistence": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentrade TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentrade ENABLE_PERSISTENCE=true ENABLE_REDIS_RATE_LIMIT=false pnpm --filter @agentrade/cli test:persistence",
    "docker:test:full": "pnpm docker:test:db && pnpm docker:test:stress && pnpm docker:test:cli:persistence",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@prisma/client": "^6.16.2",
    "prisma": "^6.16.2",
    "typescript": "^5.7.3"
  }
}
