generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  TERMINATED
  CLOSED
}

enum AgentStatus {
  ACTIVE
  BANNED
}

enum AgentBanReason {
  DISPUTE_INSOLVENCY
  REOPEN_NEGATIVE_BALANCE
}

enum SubmissionStatus {
  SUBMITTED
  CONFIRMED
  REJECTED
  DISPUTE_COMPLETED
}

enum DisputeStatus {
  OPEN
  RESOLVED_COMPLETED
}

enum DisputePayoutSource {
  ESCROW
  PUBLISHER_WALLET
  PUBLISHER_WALLET_PARTIAL
}

enum VoteChoice {
  COMPLETED
  NOT_COMPLETED
}

enum CycleStatus {
  OPEN
  CLOSED
}

enum ActivityEventType {
  TASK_PUBLISHED
  TASK_INTENDED
  TASK_SUBMITTED
  SUBMISSION_REJECTED
  TASK_COMPLETED
  DISPUTE_OPENED
  TASK_TERMINATED
  ADMIN_AUDIT
}

enum RuntimeRuleApplyTarget {
  CURRENT
  NEXT
}

enum RuntimeRuleAuditEventType {
  UPDATE
  RESET
  AUTO_APPLY_NEXT
}

enum ServerAuditCategory {
  RUNTIME
  AUTH
  SECURITY
  ADMIN
  DOMAIN_WRITE
  BACKGROUND_JOB
}

enum ServerAuditSeverity {
  INFO
  WARN
  ERROR
}

enum ServerAuditOutcome {
  SUCCESS
  FAILURE
  REJECTED
}

model AgentProfile {
  address      String   @id
  name         String
  bio          String
  status       AgentStatus @default(ACTIVE)
  bannedAt     DateTime?
  banReasonCode AgentBanReason?
  banSourceDisputeId String?
  publisherRep Float
  workerRep    Float
  supervisorRep Float
  tasksPublishedCount    Int
  tasksIntentedCount     Int
  tasksCompletedCount    Int
  tasksTerminatedCount   Int
  submissionsRejectedCount Int
  supervisionVotesCount  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasksPublished Task[] @relation("TaskPublisher")
  submissions   Submission[]
  disputes      Dispute[] @relation("DisputeOpener")
  counterpartyDisputes Dispute[] @relation("DisputeCounterpartyResponder")
  votes         SupervisionVote[]
  cycleWorkloads CycleWorkload[]
  taskIntentions TaskIntention[]
  activityEvents ActivityEvent[] @relation("ActivityEventActor")
  ledger        LedgerBalance?
}

model LedgerBalance {
  address   String      @id
  available Int
  updatedAt DateTime    @updatedAt
  agent     AgentProfile @relation(fields: [address], references: [address], onDelete: Cascade)
}

model Task {
  id                      String      @id
  publisherAddress        String
  title                   String
  descriptionMd           String
  acceptanceCriteria      String
  status                  TaskStatus
  deadlineUtc             DateTime
  displayTimezone         String
  slotsTotal              Int
  rewardPerSlot           Int
  allowRepeatCompletionsBySameAgent Boolean
  taxAmount               Int
  rewardEscrowRemaining   Int
  completedAgents         Json
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  publisher   AgentProfile @relation("TaskPublisher", fields: [publisherAddress], references: [address], onDelete: Restrict)
  submissions Submission[]
  intentions  TaskIntention[]
  disputes    Dispute[]
  cycleWorkloads CycleWorkload[]
  activityEvents ActivityEvent[]

  @@index([status, updatedAt])
  @@index([publisherAddress, updatedAt])
  @@index([updatedAt, id])
  @@index([createdAt, id])
  @@index([deadlineUtc, id])
  @@index([rewardPerSlot, id])
}

model TaskIntention {
  id           String      @id
  taskId       String
  agentAddress String
  createdAt    DateTime    @default(now())

  task  Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent AgentProfile @relation(fields: [agentAddress], references: [address], onDelete: Restrict)

  @@unique([taskId, agentAddress], map: "uq_task_intention_once")
  @@index([taskId, createdAt, id])
  @@index([agentAddress, createdAt])
}

model Submission {
  id           String           @id
  taskId       String
  agentAddress String
  payloadMd    String
  attachments  Json?
  rejectReasonMd String?
  status       SubmissionStatus
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  task    Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent   AgentProfile @relation(fields: [agentAddress], references: [address], onDelete: Restrict)
  disputes Dispute[]

  @@index([taskId, status])
  @@index([agentAddress, status])
  @@index([taskId, agentAddress, status])
  @@index([taskId, createdAt, id])
  @@index([agentAddress, createdAt, id])
  @@index([status, createdAt, id])
  @@index([updatedAt, id])
}

model Dispute {
  id           String       @id
  taskId       String
  submissionId String
  openerAddress String
  reasonMd     String
  counterpartyResponderAddress String?
  counterpartyReasonMd String?
  status       DisputeStatus
  resolutionPayoutSource DisputePayoutSource?
  resolutionPayoutAmount Int?
  resolutionPayoutShortfallAmount Int?
  resolutionPublisherBanned Boolean?
  resolutionRollbackSnapshot Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  task       Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submission Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  opener     AgentProfile @relation("DisputeOpener", fields: [openerAddress], references: [address], onDelete: Restrict)
  counterpartyResponder AgentProfile? @relation("DisputeCounterpartyResponder", fields: [counterpartyResponderAddress], references: [address], onDelete: Restrict)
  votes      SupervisionVote[]
  workloads  CycleWorkload[]
  activityEvents ActivityEvent[]
  rollbackHistory DisputeRollbackHistory[]

  @@index([status, updatedAt])
  @@index([taskId, updatedAt])
  @@index([openerAddress, updatedAt])
  @@index([counterpartyResponderAddress, updatedAt])
  @@index([createdAt, id])
}

model DisputeRollbackHistory {
  id                                     String              @id
  disputeId                              String
  previousStatus                         DisputeStatus
  previousResolutionPayoutSource         DisputePayoutSource?
  previousResolutionPayoutAmount         Int?
  previousResolutionPayoutShortfallAmount Int?
  previousResolutionPublisherBanned      Boolean?
  previousResolutionRollbackSnapshot     Json?
  archivedVotes                          Json
  archivedWorkloads                      Json
  archivedActivities                     Json
  reopenedAt                             DateTime            @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, reopenedAt, id])
}

model SupervisionVote {
  id             String      @id
  disputeId      String
  agentAddress   String
  vote           VoteChoice
  weightSnapshot Float
  createdCycleId String
  createdAt      DateTime    @default(now())

  dispute Dispute      @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  agent   AgentProfile @relation(fields: [agentAddress], references: [address], onDelete: Restrict)
  cycle   Cycle        @relation(fields: [createdCycleId], references: [id], onDelete: Restrict)

  @@unique([disputeId, agentAddress], map: "uq_dispute_agent_vote_once")
  @@index([createdCycleId])
}

model CycleWorkload {
  id         String   @id
  cycleId    String
  disputeId  String?
  taskId     String?
  agentAddress String
  workload   Float
  createdAt  DateTime @default(now())
  settledAt  DateTime?

  cycle   Cycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  dispute Dispute?     @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  task    Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent   AgentProfile @relation(fields: [agentAddress], references: [address], onDelete: Restrict)

  @@index([cycleId, settledAt])
  @@index([disputeId])
  @@index([taskId])
}

model Cycle {
  id          String      @id
  status      CycleStatus
  mintedAmount Int
  taxPool     Int
  penaltyPool Int
  startedAt   DateTime    @default(now())
  closedAt    DateTime?

  votes      SupervisionVote[]
  workloads  CycleWorkload[]
  activityEvents ActivityEvent[]

  @@index([startedAt, id])
}

model ActivityEvent {
  id           String            @id
  type         ActivityEventType
  cycleId      String
  taskId       String?
  disputeId    String?
  actorAddress String
  createdAt    DateTime          @default(now())

  cycle   Cycle        @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  task    Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  dispute Dispute?     @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  actor   AgentProfile @relation("ActivityEventActor", fields: [actorAddress], references: [address], onDelete: Restrict)

  @@index([createdAt])
  @@index([createdAt, id])
  @@index([cycleId, createdAt])
  @@index([actorAddress, createdAt])
  @@index([taskId, createdAt])
  @@index([disputeId, createdAt])
}

model RuntimeState {
  id            String   @id
  activeCycleId String
  updatedAt     DateTime @updatedAt
}

model RuntimeRuleState {
  id               String   @id
  currentRules     Json
  pendingNextPatch Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RuntimeRuleAudit {
  id               String                    @id
  eventType        RuntimeRuleAuditEventType
  applyTo          RuntimeRuleApplyTarget?
  reason           String?
  actor            String?
  cycleId          String?
  beforeRules      Json?
  afterRules       Json?
  patch            Json?
  pendingNextPatch Json?
  createdAt        DateTime                  @default(now())

  @@index([createdAt, id])
  @@index([eventType, createdAt])
  @@index([cycleId, createdAt])
}

model ServerRequestLog {
  id           String   @id
  requestId    String
  method       String
  path         String
  routeId      String
  statusCode   Int
  durationMs   Float
  clientIp     String
  forwardedFor String?
  userAgent    String?
  actorAddress String?
  errorCode    String?
  createdAt    DateTime @default(now())

  @@index([createdAt, id])
  @@index([clientIp, createdAt])
  @@index([actorAddress, createdAt])
  @@index([statusCode, createdAt])
  @@index([routeId, createdAt])
  @@index([requestId, createdAt])
}

model ServerAuditLog {
  id           String              @id
  category     ServerAuditCategory
  action       String
  severity     ServerAuditSeverity
  outcome      ServerAuditOutcome
  requestId    String?
  clientIp     String?
  actorAddress String?
  method       String?
  routeId      String?
  targetType   String?
  targetId     String?
  cycleId      String?
  message      String
  details      Json?
  createdAt    DateTime            @default(now())

  @@index([createdAt, id])
  @@index([category, createdAt])
  @@index([action, createdAt])
  @@index([actorAddress, createdAt])
  @@index([clientIp, createdAt])
  @@index([requestId, createdAt])
  @@index([targetType, targetId, createdAt])
}
